# Starts with simulated replies. No provider calls until explicitly changed.
AI_MODE=mock
HOST=0.0.0.0
PORT=8787
# Set the same private proxy token in the iPhone's Connection settings.
APP_TOKEN=
GEMINI_API_KEY=
# Everyday questions: the fast model. Explanations use EXPLAIN_MODEL below.
GEMINI_MODEL=gemini-3.5-flash-lite
MAX_OUTPUT_TOKENS=2048

# Research is chosen when useful. Gemini model quotas and Serper search credits are separate.
ENABLE_WEB_RESEARCH=true
# Get your Serper key at https://serper.dev/ — keep it on the backend.
SERPER_API_KEY=
SERPER_COUNTRY=ca
SERPER_LANGUAGE=en
# At most two research operations per question. Each search action uses one Serper query.
MAX_RESEARCH_STEPS=2
# Natural spoken replies generated by Gemini (the phone falls back to its own voice if this fails).
ENABLE_GEMINI_VOICE=true
# gemini-3.8-flash-lite-tts is faster; gemini-3.8-flash-tts sounds best.
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
# Default voice when the app does not choose one (e.g. Kore, Aoede, Puck, Charon, Achird).
GEMINI_TTS_VOICE=Kore
# How much detail Gemini uses per camera image: medium (faster), high (best for tiny text and keys), low, or default.
IMAGE_DETAIL=medium
# Model for explanation questions (walkthroughs: paths, arrows, zoom). "same" uses GEMINI_MODEL for everything.
EXPLAIN_MODEL=same
# Auto uses minimal reasoning for basic Flash-Lite questions, low for detailed work.
# Override with low/medium/high; minimal is clamped to low on models without support.
GEMINI_THINKING_LEVEL=auto
