# Starts with simulated replies. No provider calls until explicitly changed.
AI_MODE=mock
HOST=0.0.0.0
PORT=8787
# Set the same private proxy token in the iPhone's Connection settings.
APP_TOKEN=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
MAX_OUTPUT_TOKENS=2048

# Research is chosen when useful. Gemini model quotas and Serper search credits are separate.
ENABLE_WEB_RESEARCH=true
# Get your Serper key at https://serper.dev/ — keep it on the backend.
SERPER_API_KEY=
SERPER_COUNTRY=ca
SERPER_LANGUAGE=en
# At most two research operations per question. Each search action uses one Serper query.
MAX_RESEARCH_STEPS=2
