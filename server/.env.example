# Starts with simulated replies. No provider calls until explicitly changed.
AI_MODE=mock
HOST=0.0.0.0
PORT=8787
# Set the same private proxy token in the iPhone's Connection settings.
APP_TOKEN=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
MAX_OUTPUT_TOKENS=2048

# Research is chosen by the assistant when needed. Google enforces API quotas.
ENABLE_WEB_RESEARCH=true
# At most two research operations (up to five model calls) per spoken question.
MAX_RESEARCH_STEPS=2
