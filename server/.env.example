# Starts with simulated replies. No provider calls until explicitly changed.
AI_MODE=mock
HOST=0.0.0.0
PORT=8787
# Set the same private proxy token in the iPhone's Connection settings.
APP_TOKEN=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Persistent allowance across restarts. Failed/aborted attempts also consume a slot.
# This is a request limit, NOT a guaranteed dollar spending cap.
MAX_LIVE_REQUESTS=50
REQUESTS_PER_MINUTE=10
MAX_OUTPUT_TOKENS=2048
